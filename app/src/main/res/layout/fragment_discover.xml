<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- ⚡ 极其牛逼的防绞杀滑动外壳！！ -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ⚡ 朋友圈头部区 -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="320dp">

                <ImageView
                    android:id="@+id/ivCover"
                    android:layout_width="match_parent"
                    android:layout_height="280dp"
                    android:scaleType="centerCrop"
                    android:background="#333333" />

                <TextView
                    android:id="@+id/tvMyName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignBottom="@+id/ivCover"
                    android:layout_toStartOf="@+id/ivMyAvatar"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="12dp"
                    android:text="加载中..."
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:shadowColor="#80000000"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="4"/>

                <ImageView
                    android:id="@+id/ivMyAvatar"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentBottom="true"
                    android:layout_marginEnd="16dp"
                    android:background="#EEEEEE"
                    android:scaleType="centerCrop" />
            </RelativeLayout>

            <!-- ⚡ 动态列表容器 -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMoments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:paddingBottom="60dp"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ⚡ 顶部的操作按钮 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:paddingHorizontal="16dp"
        android:background="#44000000">

        <ImageView
            android:id="@+id/btnGenerateMoment"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_toStartOf="@+id/btnAddMoment"
            android:layout_marginEnd="20dp"
            android:layout_centerVertical="true"
            android:src="@android:drawable/ic_popup_sync"
            android:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/btnAddMoment"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@android:drawable/ic_menu_camera"
            android:tint="#FFFFFF" />
    </RelativeLayout>

</RelativeLayout>