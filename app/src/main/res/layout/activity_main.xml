<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ImageView
        android:id="@+id/ivMainWallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:id="@+id/topContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="20dp">
        <!-- 音乐小组件 -->
        <WebView
            android:id="@+id/wvMusicWidget"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginBottom="12dp"
            android:elevation="4dp"
            android:clipToOutline="true"
            android:background="@drawable/bg_music_panel" />

        <!-- 时钟+天气 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical|start"
            android:layout_marginBottom="15dp">

            <TextView
                android:id="@+id/tvDesktopTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="14:52"
                android:textColor="#FFFFFF"
                android:textSize="72sp"
                android:shadowColor="#66000000"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="5" />

            <LinearLayout
                android:id="@+id/btnOpenWeather"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp">

                <TextView
                    android:id="@+id/tvDesktopWeather"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="☁️ 22°C"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:shadowColor="#66000000"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="3" />
            </LinearLayout>
        </LinearLayout>

        <!-- 日历 -->
        <LinearLayout
            android:id="@+id/btnOpenCalendar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_glass_panel"
            android:padding="16dp"
            android:elevation="4dp">

            <TextView
                android:id="@+id/tvCalendarYearMonth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2026年5月"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"
                android:layout_marginStart="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="SUN" android:textColor="#BBBBBB" android:textSize="12sp"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="MON" android:textColor="#BBBBBB" android:textSize="12sp"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="TUE" android:textColor="#BBBBBB" android:textSize="12sp"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="WED" android:textColor="#BBBBBB" android:textSize="12sp"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="THU" android:textColor="#BBBBBB" android:textSize="12sp"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="FRI" android:textColor="#BBBBBB" android:textSize="12sp"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="SAT" android:textColor="#BBBBBB" android:textSize="12sp"/>
            </LinearLayout>

            <GridLayout
                android:id="@+id/glCalendarDays"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="7"
                android:rowCount="1"
                android:alignmentMode="alignBounds">
            </GridLayout>
        </LinearLayout>

    </LinearLayout>

    <!-- 中间可滑动图标区域 -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/desktopViewPager"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/topContainer"
        android:layout_above="@id/desktopDock"
        android:layout_marginBottom="8dp" />

    <!-- 小圆点指示器 -->
    <LinearLayout
        android:id="@+id/desktopPageIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/desktopDock"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="4dp"
        android:orientation="horizontal"
        android:gravity="center" />
    <!-- 下排图标：设置 / Chat / 世界书 -->
    <LinearLayout
        android:id="@+id/desktopDock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="40dp"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/btnSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:padding="13dp"
                android:tint="#000000"
                android:scaleType="fitCenter"
                android:elevation="4dp"
                android:src="@drawable/ic_settings" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="设置"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:shadowColor="#66000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="2" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnOpenChat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:gravity="center"
            android:orientation="vertical">
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:padding="13dp"
                    android:tint="#000000"
                    android:scaleType="fitCenter"
                    android:elevation="4dp"
                    android:src="@drawable/ic_chat" />
                <TextView
                    android:id="@+id/tvDesktopChatBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="-2dp"
                    android:layout_marginEnd="-2dp"
                    android:background="@drawable/bg_red_dot"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="5dp"
                    android:paddingVertical="1dp"
                    android:text="99"
                    android:elevation="6dp"
                    android:visibility="gone"/>
            </FrameLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Chat"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:shadowColor="#66000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="2" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnOpenWorldBook"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:padding="13dp"
                android:tint="#000000"
                android:scaleType="fitCenter"
                android:elevation="4dp"
                android:src="@drawable/ic_worldbook_png" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="世界书"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:shadowColor="#66000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="2" />
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>