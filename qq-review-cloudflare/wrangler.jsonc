{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "qq-review-cloudflare",
  "main": "src/index.js",
  "compatibility_date": "2026-07-23",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/admin/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "qq-review",
      "database_id": "09dad37a-7091-40b7-b5ec-a1ea5ab26ceb",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "SUBMIT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "IMAGE_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "vars": {
    "REQUIRED_GROUP": "595862009",
    "OPTIONAL_GROUP": "1103798415",
    "TURNSTILE_SITE_KEY": "",
    "OWNER_EMAIL": "1990709164@qq.com"
  },
  "secrets": {
    "required": ["SESSION_SECRET", "OWNER_INITIAL_PASSWORD"]
  },
  "observability": {
    "enabled": true
  }
}
